# Copie este arquivo para ".env" e preencha os valores.

# Usuário e senha do painel (/admin). A senha só é lida na PRIMEIRA vez que o
# servidor sobe; depois ela fica guardada (criptografada) em data/admin.json e
# pode ser trocada pelo próprio painel.
ADMIN_USER=erika
ADMIN_PASSWORD=troque-esta-senha

# Texto longo e aleatório usado para assinar a sessão de login.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Porta do servidor
PORT=3001

# Pasta onde ficam o conteúdo e as imagens enviadas (precisa ser persistente!)
DATA_DIR=data
